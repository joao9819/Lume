---
import '../styles/global.css';
import clinica from '../data/clinica.json';
import frauncesNormal from '../fonts/fraunces-lume-normal.woff2?url';
import frauncesItalic from '../fonts/fraunces-lume-italic.woff2?url';
import hanken from '../fonts/hanken-grotesk-latin.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const { title = clinica.seo.title, description = clinica.seo.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.jpg', Astro.site).href;
const c = clinica.contato;

// Dados estruturados (fictícios, ver clinica.json)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: clinica.marca.nomeCompleto,
  description,
  url: Astro.site?.href,
  image: og,
  telephone: `+${c.whatsapp}`,
  priceRange: 'R$ 160 - R$ 1.800',
  foundingDate: clinica.marca.fundacao,
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.endereco.rua,
    addressLocality: c.endereco.cidade,
    addressRegion: c.endereco.uf,
    addressCountry: c.endereco.pais,
  },
  areaServed: `${c.endereco.bairro}, ${c.endereco.cidade}`,
  openingHours: c.horarios.map((h) => h.schema),
  sameAs: [c.instagramUrl],
  paymentAccepted: 'Pix, débito, crédito',
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F4EFE7" />
    <meta name="robots" content="noindex" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={clinica.marca.nomeCompleto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lume Estética: Resultado natural é o nosso luxo" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={frauncesNormal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hanken} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Estado inicial das animações só quando há JS e o usuário aceita movimento.
      (function () {
        var d = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          setTimeout(function () { if (!d.classList.contains('motion-ready')) d.classList.remove('motion'); }, 3500);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-cafe focus:px-4 focus:py-3 focus:text-linho">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
