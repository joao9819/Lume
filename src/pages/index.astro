---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Abordagem from '../components/Abordagem.astro';
import Tratamentos from '../components/Tratamentos.astro';
import Ritual from '../components/Ritual.astro';
import Passos from '../components/Passos.astro';
import Ambiente from '../components/Ambiente.astro';
import Equipe from '../components/Equipe.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Oferta from '../components/Oferta.astro';
import Faq from '../components/Faq.astro';
import Agendamento from '../components/Agendamento.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
---
<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Abordagem />
    <Tratamentos />
    <Ritual />
    <Passos />
    <Ambiente />
    <Equipe />
    <Depoimentos />
    <Oferta />
    <Faq />
    <Agendamento />
  </main>
  <Footer />
  <MobileCTA />
</Base>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) import('../scripts/motion');
</script>
