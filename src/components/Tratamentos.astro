---
import clinica from '../data/clinica.json';
import Title from './Title.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { waTratamento } from '../lib/wa';
const t = clinica.tratamentos;
---
<section id="tratamentos" class="bg-areia py-[var(--spacing-section)]" aria-labelledby="tratamentos-titulo">
  <div class="wrap">
    <p class="eyebrow text-argila" data-rise>{t.eyebrow}</p>
    <Title id="tratamentos-titulo" lines={t.titulo} class="mt-6" />
  </div>

  <!-- Celular: rolagem lateral manual com encaixe; desktop: grade 3 colunas com a do meio deslocada -->
  <ul class="tratamentos-lista mt-14 lg:mt-20" role="list">
    {t.itens.map((item) => (
      <li class="tratamento">
        <article class="flex h-full flex-col" data-rise>
          <Photo
            name={item.imagem}
            alt={`${item.categoria}: ${item.nome}`}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 78vw"
            widths={[400, 600, 800, 1000]}
            class="block aspect-[4/5] w-full overflow-hidden rounded-sm"
            imgClass="h-full w-full object-cover"
          />
          <p class="mt-5 text-[0.875rem] font-medium text-argila">{item.categoria}</p>
          <h3 class="display text-h3 mt-2">{item.nome}</h3>
          <p class="mt-3 text-argila">{item.descricao}</p>
          <div class="mt-auto pt-6">
            <p class="flex items-baseline justify-between gap-4 border-t border-argila/30 pt-4 text-[0.9375rem]">
              <span>{item.duracao}<span class="px-2 text-argila" aria-hidden="true">·</span><span class="sr-only">, </span>{item.preco}</span>
            </p>
            <a class="link-u mt-4 inline-flex items-center gap-2 font-medium text-terracota" href={waTratamento(item.nome)} target="_blank" rel="noopener" aria-label={`${t.link.replace(" →", "")}: ${item.nome}`}>
              {t.link.replace(' →', '')}<Icon name="arrow-right" />
            </a>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .tratamentos-lista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 22rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--spacing-gutter);
    padding-inline: var(--spacing-gutter);
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-argila) transparent;
    contain: paint; /* evita que o Chromium some a largura do trilho ao documento */
  }
  .tratamento { scroll-snap-align: start; }
  @media (min-width: 640px) {
    .tratamentos-lista {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
      contain: none;
      max-width: 90rem;
      margin-inline: auto;
      column-gap: clamp(1rem, 0.6rem + 1.25vw, 2rem);
      row-gap: 4rem;
    }
  }
  @media (min-width: 1024px) {
    .tratamentos-lista { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 5rem; }
    .tratamento:nth-child(3n + 2) { transform: translateY(4rem); }
    .tratamentos-lista { padding-bottom: 4rem; }
  }
</style>
