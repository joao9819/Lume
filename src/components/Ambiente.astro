---
import clinica from '../data/clinica.json';
import Title from './Title.astro';
import Photo from './Photo.astro';
const a = clinica.ambiente;
---
<section id="clinica" class="bg-areia py-[var(--spacing-section)]" aria-labelledby="clinica-titulo">
  <div class="wrap grid-12 gap-y-14">
    <div class="col-span-12 self-end md:col-span-6 lg:col-span-5">
      <p class="eyebrow text-argila" data-rise>{a.eyebrow}</p>
      <Title id="clinica-titulo" lines={a.titulo} class="mt-6" />
      <p class="measure mt-8 text-argila" data-rise>{a.texto}</p>
    </div>
    <div class="col-span-12 md:col-span-6 lg:col-span-6 lg:col-start-7">
      <div class="arch-frame mx-auto w-[min(100%,30rem)] md:w-full" data-slit>
        <Photo
          name={a.imagem}
          alt={a.imagemAlt}
          sizes="(min-width: 1024px) 44vw, (min-width: 768px) 48vw, 90vw"
          widths={[480, 720, 960, 1280]}
          class="block aspect-[5/6] w-full"
          imgClass="h-full w-full object-cover"
        />
      </div>
    </div>
    <ul class="col-span-12 mt-6 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-argila/30 pt-8 lg:mt-12 lg:grid-cols-4 lg:gap-x-8" role="list">
      {a.sentidos.map((s) => (
        <li data-rise>
          <h3 class="display text-h3">{s.nome}</h3>
          <p class="mt-2 text-argila">{s.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
