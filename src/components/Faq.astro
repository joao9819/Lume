---
import clinica from '../data/clinica.json';
import Title from './Title.astro';
const f = clinica.faq;
---
<section id="duvidas" class="bg-linho py-[var(--spacing-section)]" aria-labelledby="duvidas-titulo">
  <div class="wrap grid-12 gap-y-12">
    <div class="col-span-12 lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <Title id="duvidas-titulo" lines={f.titulo} />
      </div>
    </div>
    <div class="faq col-span-12 border-t border-argila/30 lg:col-span-6 lg:col-start-7">
      {f.itens.map((item) => (
        <details class="faq-item border-b border-argila/30" data-rise>
          <summary class="faq-q">
            <span class="text-[1.125rem] font-medium lg:text-[1.25rem]">{item.pergunta}</span>
            <span class="faq-sinal" aria-hidden="true"></span>
          </summary>
          <div class="faq-a">
            <p class="measure text-argila">{item.resposta}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover span:first-child { color: var(--color-terracota); }
  /* + que vira − (só transform) */
  .faq-sinal { position: relative; flex: none; width: 1rem; height: 1rem; }
  .faq-sinal::before, .faq-sinal::after {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease-lume);
  }
  .faq-sinal::after { transform: rotate(90deg); }
  details[open] .faq-sinal::after { transform: rotate(0deg); }
  .faq-a { padding: 0 2.5rem 1.75rem 0; }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq-a { animation: faq-in 0.45s var(--ease-lume); }
  }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>
